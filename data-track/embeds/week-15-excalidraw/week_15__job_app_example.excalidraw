    {
      "id": "legend",
      "type": "text",
      "x": 60,
      "y": 560,
      "width": 353.4,
      "height": 526.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1442985923,
      "version": 1,
      "versionNonce": 829400901,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Steps, not tools. Which database and\nwhich transformation tool fills each\nstep is in the architecture chapter.\n\nSolid arrows stay inside one component\nand one codebase.\n\nThe three dashed arrows are the only\nplaces data crosses between\ncomponents, which is exactly where the\ncontracts apply.\n\nTwo kinds of number, decided by what\nthe answer needs as input:\n\n  Only current rows, and it has to\n  match what the user just did:\n  counted in place. A saved count\n  that lags by a day is a bug.\n\n  Needs the listings, or history the\n  application does not keep: round\n  the loop and back as a trend.\n\nWithout the pipeline the search page\nis empty. Without the application\nthere is nothing to read back.",
      "originalText": "Steps, not tools. Which database and\nwhich transformation tool fills each\nstep is in the architecture chapter.\n\nSolid arrows stay inside one component\nand one codebase.\n\nThe three dashed arrows are the only\nplaces data crosses between\ncomponents, which is exactly where the\ncontracts apply.\n\nTwo kinds of number, decided by what\nthe answer needs as input:\n\n  Only current rows, and it has to\n  match what the user just did:\n  counted in place. A saved count\n  that lags by a day is a bug.\n\n  Needs the listings, or history the\n  application does not keep: round\n  the loop and back as a trend.\n\nWithout the pipeline the search page\nis empty. Without the application\nthere is nothing to read back.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": true
    },
    {
      "id": "title2",
      "type": "text",
      "x": 60,
      "y": 1206.5,
      "width": 706.8,
      "height": 39.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1946486821,
      "version": 1,
      "versionNonce": 1307491548,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The same picture, with the tools in it",
      "originalText": "The same picture, with the tools in it",
      "fontSize": 30,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": true
    },
    {
      "id": "subtitle2",
      "type": "text",
      "x": 60,
      "y": 1258.5,
      "width": 1081.28,
      "height": 41.6,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 27236050,
      "version": 1,
      "versionNonce": 1233772845,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every step above is a component someone has to build. The Data Track's tools are fixed by the course.\nThe backend and frontend tools are their tracks' choices, listed here so you can see where yours meet theirs.",
      "originalText": "Every step above is a component someone has to build. The Data Track's tools are fixed by the course.\nThe backend and frontend tools are their tracks' choices, listed here so you can see where yours meet theirs.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": true
    },
